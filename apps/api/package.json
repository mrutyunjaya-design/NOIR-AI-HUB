{
  "name": "@noir/api",
  "version": "0.1.0",
  "description": "NOIR AI HUB Express API",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@noir/database": "workspace:*",
    "@noir/ai-core": "workspace:*",
    "@noir/auth": "workspace:*",
    "@noir/security": "workspace:*",
    "@noir/logger": "workspace:*",
    "dotenv": "^16.3.1",
    "zod": "^3.22.0",
    "jsonwebtoken": "^9.1.0",
    "axios": "^1.6.0",
    "redis": "^4.6.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/compression": "^1.7.2",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^1.0.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  }
}
