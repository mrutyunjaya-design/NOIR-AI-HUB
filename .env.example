# NOIR AI HUB Environment Variables

# Database
DATABASE_URL="postgresql://noir:noir@localhost:5432/noir_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"

# Session
SESSION_SECRET="your-session-secret-change-in-production"

# API
API_PORT=4000
API_HOST="localhost"
NODE_ENV="development"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Provider API Keys (optional for BYOK mode)
# Users can add their own via the UI
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
PERPLEXITY_API_KEY=""
XAI_API_KEY=""

# Ollama
OLLAMA_BASE_URL="http://localhost:11434"

# Email (for password reset, verification)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@noir-ai-hub.dev"

# File Storage (S3-compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="noir-files"
S3_REGION="us-east-1"

# Observability
OTLP_ENDPOINT=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple OAuth
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Admin
ADMIN_EMAIL="admin@noir-ai-hub.dev"
ADMIN_PASSWORD=""
